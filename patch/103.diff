+    TableOpenContextMenu(ref, menu_column_n);
+
+    ImGuiTestRef backup_ref = GetRef();
+    SetRef("//$FOCUSED");
+    const char* label = ImGui::TableGetColumnName(table, column_n);
+    if (enabled)
+        ItemCheck(label);
+    else
+        ItemUncheck(label);
+    PopupCloseOne();
+    SetRef(backup_ref);
